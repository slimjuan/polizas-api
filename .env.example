# Copien este archivo a .env y cambien los valores. .env NO se versiona.
# Con estos valores de ejemplo el servicio arranca en local.
DATABASE_URL=sqlite:///app.db
RUTA_MODELO=modelo.pkl
UMBRAL_ALTO_RIESGO=0.6
# Secretos: en producción se inyectan por entorno, nunca en el repositorio.
SECRETO_FIRMA=cambiar-este-secreto-de-ejemplo
CLAVE_API_REASEGURO=cambiar-esta-clave-de-ejemplo
